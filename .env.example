# ============================================
# LibraX Environment Variables Template
# ============================================

# Database Configuration
# - For Docker: automatically configured in docker-compose.yml (DB_HOST=db, DB_PASSWORD=rootpassword)
# - For Local (e.g. XAMPP):
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=librax_db

# Application Server Port
PORT=3000

